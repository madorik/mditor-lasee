# 서비스 주소(끝에 / 없이). 사이트맵, 문서 링크, MCP 의 PDF 내려받기 링크에 쓴다.
MDITOR_PUBLIC_URL=https://example.com

# ── 광고 (Google AdSense) ─ 비워 두면 광고 코드를 넣지 않는다
ADSENSE_CLIENT=            # ca-pub-0000000000000000
ADSENSE_SLOT_CONTENT=      # 내용 쪽(첫 화면·문법·개발자)에 들어갈 광고 단위 ID
ADSENSE_SLOT_EDITOR=       # 편집 화면 아래 띠에 들어갈 광고 단위 ID
GOOGLE_SITE_VERIFICATION=  # Search Console 소유 확인 값(선택)
NAVER_SITE_VERIFICATION=   # 네이버 서치어드바이저 소유 확인 값(선택)
BING_SITE_VERIFICATION=    # Bing 웹마스터 도구 소유 확인 값(선택, msvalidate.01)
MDITOR_CONTACT_EMAIL=      # 개인정보처리방침·약관에 보일 문의 주소

# ── AI 로 고치기 ─ 키가 있으면 켜진다. 호출마다 비용이 든다
ANTHROPIC_API_KEY=
MDITOR_AI_MODEL=claude-opus-5-5
MDITOR_AI_EFFORT=medium
MDITOR_AI_DAILY_LIMIT=10       # IP 하나가 하루에 쓸 수 있는 횟수
MDITOR_AI_MAX_MD_CHARS=60000   # 이보다 긴 문서는 AI 수정을 받지 않는다

# ── 그림 저장소 ─ 넷이 모두 있으면 편집기에서 넣은 그림을 Cloudflare R2 에 올리고 /i/<이름> 으로 내준다.
#    비워 두면 그림은 예전처럼 문서와 함께 브라우저에만 둔다. R2 대신 디스크 폴더에 두려면 MDITOR_IMAGE_DIR.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MDITOR_IMAGE_DIR=                    # 예: /data/images (도커 볼륨)
MDITOR_MAX_IMAGE_FILE_BYTES=10000000 # 넣을 수 있는 원본 그림 파일 한 장(화면이 줄이기 전에 본다)
MDITOR_MAX_UPLOAD_BYTES=3000000      # 줄인 뒤 올리는 그림 한 장(서버가 본다)
MDITOR_UPLOAD_DAILY_LIMIT=100        # IP 하나가 하루에 올릴 수 있는 그림 수
MDITOR_IMAGE_TTL_DAYS=3              # 올린 그림을 두는 날 수. R2 는 버킷 수명 규칙(lifecycle)과 맞춘다

# ── 한도 ─
MDITOR_RATE_PER_MINUTE=240     # IP 하나의 분당 요청 수(미리보기·PDF·MCP)
MDITOR_MAX_MD_CHARS=400000
MDITOR_MAX_IMAGE_BYTES=8000000
MDITOR_DOWNLOAD_TTL=1800       # MCP 가 만든 PDF 링크가 살아 있는 시간(초)
MDITOR_TRUST_PROXY=1           # 프록시 뒤에 있으면 1 (X-Forwarded-For 로 IP 를 센다)
WEB_CONCURRENCY=1              # 프로세스 수. 2 이상이면 횟수 제한을 프로세스마다 따로 센다

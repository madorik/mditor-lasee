{
  "name": "@watalabs/lasee-mditor",
  "version": "0.2.1",
  "description": "Markdown document editor — edit what you see, keep Markdown as the source. Toolbar, tables with merged cells, lists, code blocks, find & replace, source mode, preview.",
  "license": "MIT",
  "author": "WataLabs (https://watalabs.com)",
  "homepage": "https://lasee.watalabs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madorik/mditor-lasee.git",
    "directory": "web/packages/lasee-mditor"
  },
  "bugs": {
    "url": "https://github.com/madorik/mditor-lasee/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/lasee-mditor.umd.js",
  "jsdelivr": "./dist/lasee-mditor.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": "./dist/style.css",
    "./umd": "./dist/lasee-mditor.umd.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "tiptap",
    "prosemirror",
    "korean"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && vite build --mode umd && cp src/style.css dist/style.css && tsc -p tsconfig.build.json",
    "dev": "vite --open /demo/",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-code": "3.32.1",
    "@tiptap/extension-paragraph": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/starter-kit": "3.32.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
